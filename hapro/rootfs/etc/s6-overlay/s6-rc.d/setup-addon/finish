#!/usr/bin/with-contenv bashio
declare APP_EXIT_CODE=${1}
declare container="setup-addon"

# setup-addon is a oneshot — it either completes (exit 0/256) or something
# truly unexpected happened. Either way, do not halt the container.
if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "$container exited with code ${APP_EXIT_CODE} — s6 will handle restart."
else
  bashio::log.info "$container completed successfully."
fi