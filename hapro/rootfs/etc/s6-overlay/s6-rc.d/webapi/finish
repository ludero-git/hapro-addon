#!/usr/bin/with-contenv bashio
declare APP_EXIT_CODE=${1}
declare container="webapi"

if [[ "${APP_EXIT_CODE}" -eq 137 ]]; then
  bashio::log.warning "Container $container was killed (OOM or SIGKILL) — s6 will restart it automatically."
elif [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "$container exited with code ${APP_EXIT_CODE} — s6 will restart it automatically."
else
  bashio::log.info "Automatically restarting $container with exit code ${APP_EXIT_CODE}"
fi